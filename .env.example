# --- Application (Phase 1 — active) ---
APP_NAME=Transcribe Pro API
APP_VERSION=0.1.0
DEBUG=false
ENVIRONMENT=development

# API server
API_HOST=0.0.0.0
API_PORT=8000

# CORS (comma-separated origins; use * only in local dev)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Logging
LOG_LEVEL=INFO

# --- Phase 2+ (documented only — not used yet) ---

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/transcribe_pro

JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
# JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

